{
  "name": "kajuju-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation tests",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=e2e",
    "test:monitor": "playwright test --project=monitoring",
    "test:ui": "playwright test --project=e2e --ui",
    "test:headed": "playwright test --project=e2e --headed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:rates": "playwright test --project=rates"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
